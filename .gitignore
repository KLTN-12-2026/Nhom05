# Root Monorepo Git Ignore

# IDE & Editor files
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Build Artifacts & Dependencies
node_modules/
dist/
dist-ssr/
build/
.gradle/
out/
bin/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Server Local Uploads
uploads/
**/uploads/pdfs/*.pdf

# Expo / Mobile cache
.expo/
