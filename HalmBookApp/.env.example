# Sao chép file này thành .env hoặc .env.local và thay IP thành IPv4 máy chạy Spring Boot Backend
# Đối với thiết bị thật, dùng IPv4 mạng LAN của máy tính và đảm bảo điện thoại cùng mạng WiFi
EXPO_PUBLIC_API_URL=http://192.168.10.190:8082

# Google OAuth Client ID
# Lưu ý: Expo yêu cầu tiền tố EXPO_PUBLIC_ để biến được nhúng vào mã nguồn chạy trên điện thoại/web
EXPO_PUBLIC_GOOGLE_CLIENT_ID=994619857768-6ipg7lvdn9voai235f4e7gdtheuclds4.apps.googleusercontent.com
EXPO_GOOGLE_CLIENT_ID=994619857768-6ipg7lvdn9voai235f4e7gdtheuclds4.apps.googleusercontent.com
